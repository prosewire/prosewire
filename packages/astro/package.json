{
  "name": "@prosewire/astro",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Headless Prosewire readers and route integration for Astro.",
  "keywords": [
    "prosewire",
    "publishing",
    "astro",
    "cms"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/prosewire/prosewire.git",
    "directory": "packages/astro"
  },
  "homepage": "https://github.com/prosewire/prosewire#readme",
  "bugs": {
    "url": "https://github.com/prosewire/prosewire/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./components/PostList.astro": "./components/PostList.astro",
    "./components/PostArticle.astro": "./components/PostArticle.astro"
  },
  "files": [
    "dist",
    "components",
    "routes",
    "virtual.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "tsdown"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@prosewire/sdk": "workspace:^"
  },
  "peerDependencies": {
    "astro": ">=5 <8"
  },
  "devDependencies": {
    "@astrojs/compiler": "^2.13.1",
    "@prosewire/config": "workspace:*",
    "@types/node": "^26.2.0",
    "astro": "^7.2.4",
    "tsdown": "^0.22.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  }
}
