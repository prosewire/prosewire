---
import {
  basePath,
  baseUrl,
  publication,
  revalidate,
} from "virtual:prosewire/config";
/// <reference path="../virtual.d.ts" />
import { createPublicClient } from "@prosewire/sdk";
import PostList from "../components/PostList.astro";

const client = createPublicClient({ baseUrl, blog: publication });
const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1);
const page = Number.isFinite(requestedPage)
  ? Math.max(1, Math.trunc(requestedPage))
  : 1;
const category = Astro.url.searchParams.get("category") ?? undefined;
const result = await client.listPosts({ page, pageSize: 12, category });
Astro.response.headers.set(
  "Cache-Control",
  `public, s-maxage=${revalidate}, stale-while-revalidate=${revalidate * 5}`,
);
---

<!doctype html>
<html lang={result.blog.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{result.blog.name}</title>
    <meta name="description" content={result.blog.description} />
  </head>
  <body><PostList result={result} basePath={basePath} /></body>
</html>
