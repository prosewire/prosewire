---
import {
  basePath,
  baseUrl,
  publication,
  revalidate,
  siteUrl,
} from "virtual:prosewire/config";
/// <reference path="../virtual.d.ts" />
import { createPublicClient, type PublicPostResolution } from "@prosewire/sdk";
import PostArticle from "../components/PostArticle.astro";
import PostMetadata from "../components/PostMetadata.astro";

const client = createPublicClient({ baseUrl, blog: publication });
const result: PublicPostResolution = await client.resolvePost(
  Astro.params.slug ?? "",
);
if (result.status === "not-found")
  return new Response("Not found", { status: 404 });
if (result.status === "redirect")
  return Astro.redirect(
    `${basePath === "/" ? "" : basePath}/${encodeURIComponent(result.slug)}`,
    301,
  );
Astro.response.headers.set(
  "Cache-Control",
  `public, s-maxage=${revalidate}, stale-while-revalidate=${revalidate * 5}`,
);
const canonicalUrl =
  result.post.canonicalUrl ??
  (siteUrl
    ? new URL(
        `${basePath === "/" ? "" : basePath}/${encodeURIComponent(result.post.slug)}`,
        siteUrl,
      ).toString()
    : undefined);
---

<!doctype html>
<html lang={result.post.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <PostMetadata blog={result.blog} post={result.post} canonicalUrl={canonicalUrl} />
  </head>
  <body><PostArticle blog={result.blog} post={result.post} basePath={basePath} canonicalUrl={canonicalUrl} /></body>
</html>
