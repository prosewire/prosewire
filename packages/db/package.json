{
  "name": "@prosewire/db",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "biome lint src drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:database": "vitest run src/account-migration.test.ts src/bootstrap-password-migration.test.ts src/invitation-migration.test.ts src/publication-relationships-migration.test.ts",
    "test:coverage": "vitest run --coverage",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@prosewire/config": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  }
}
