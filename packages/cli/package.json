{
  "name": "@prosewire/cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Prosewire command-line interface.",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "bin": {
    "prosewire": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "tsdown"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@effect/platform-node-shared": "4.0.0-rc.110",
    "@prosewire/sdk": "workspace:^",
    "effect": "4.0.0-rc.110"
  },
  "devDependencies": {
    "@prosewire/config": "workspace:*",
    "@prosewire/contract": "workspace:*",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  },
  "tsdown": {
    "deps": {
      "alwaysBundle": [
        "@prosewire/contract"
      ]
    }
  }
}
