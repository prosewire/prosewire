{
  "name": "@prosewire/mcp",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Model Context Protocol server for Prosewire.",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    }
  },
  "bin": {
    "prosewire-mcp": "./dist/index.mjs"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "tsdown"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prosewire/sdk": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prosewire/config": "workspace:*",
    "@prosewire/contract": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "9.39.4",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "tsdown": {
    "entry": ["src/index.ts", "src/server.ts"],
    "deps": {
      "alwaysBundle": ["@prosewire/contract"]
    }
  }
}
