{
  "name": "@prosewire/mcp",
  "version": "0.2.1",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Model Context Protocol server for Prosewire.",
  "keywords": [
    "prosewire",
    "publishing",
    "mcp",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/prosewire/prosewire.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/prosewire/prosewire#readme",
  "bugs": {
    "url": "https://github.com/prosewire/prosewire/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    }
  },
  "bin": {
    "prosewire-mcp": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "tsdown"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@effect/platform-node-shared": "4.0.0-rc.110",
    "@prosewire/sdk": "workspace:^",
    "effect": "4.0.0-rc.110"
  },
  "devDependencies": {
    "@prosewire/config": "workspace:*",
    "@prosewire/contract": "workspace:*",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  },
  "tsdown": {
    "entry": [
      "src/index.ts",
      "src/server.ts"
    ],
    "deps": {
      "alwaysBundle": [
        "@prosewire/contract"
      ]
    }
  }
}
