{
  "name": "@prosewire/mcp",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Model Context Protocol server for Prosewire.",
  "exports": { ".": "./src/index.ts", "./server": "./src/server.ts" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "tsdown"
  },
  "publishConfig": {
    "access": "public",
    "bin": { "prosewire-mcp": "./dist/index.mjs" },
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prosewire/sdk": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prosewire/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "9.39.4",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
