{
  "name": "@prosewire/sdk",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Typed client for the Prosewire content API.",
  "repository": {
    "type": "git",
    "url": "https://github.com/prosewire/prosewire.git",
    "directory": "packages/sdk"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "tsdown"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@orpc/client": "^1.14.2",
    "@orpc/contract": "^1.14.2",
    "@orpc/openapi-client": "^1.14.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prosewire/config": "workspace:*",
    "@prosewire/contract": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "9.39.4",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "tsdown": {
    "dts": {
      "eager": true
    },
    "deps": {
      "alwaysBundle": ["@prosewire/contract"],
      "dts": {
        "alwaysBundle": ["@prosewire/contract"]
      }
    }
  }
}
