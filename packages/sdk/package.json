{
  "name": "@prosewire/sdk",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Typed client for the Prosewire content API.",
  "keywords": [
    "prosewire",
    "publishing",
    "cms",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/prosewire/prosewire.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/prosewire/prosewire#readme",
  "bugs": {
    "url": "https://github.com/prosewire/prosewire/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "tsdown"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@prosewire/config": "workspace:*",
    "@prosewire/contract": "workspace:*",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  },
  "tsdown": {
    "dts": {
      "eager": true
    },
    "deps": {
      "alwaysBundle": [
        "@prosewire/contract"
      ],
      "dts": {
        "alwaysBundle": [
          "@prosewire/contract"
        ]
      }
    }
  }
}
