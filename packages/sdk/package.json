{
  "name": "@prosewire/sdk",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Typed client for the Prosewire content API.",
  "repository": {
    "type": "git",
    "url": "https://github.com/prosewire/prosewire.git",
    "directory": "packages/sdk"
  },
  "exports": { ".": "./src/index.ts" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "prepublishOnly": "tsdown"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts"
  },
  "dependencies": {
    "@prosewire/contract": "workspace:^",
    "@orpc/client": "^1.14.2",
    "@orpc/contract": "^1.14.2",
    "@orpc/openapi-client": "^1.14.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prosewire/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "9.39.4",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
