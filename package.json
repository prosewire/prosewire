{
  "name": "prosewire",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenv -e .env -- turbo run dev",
    "dev:web": "dotenv -e .env -- pnpm --filter @prosewire/web dev",
    "dev:site": "pnpm --filter @prosewire/site dev",
    "dev:services": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres redis",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:packages",
    "test:packages": "node scripts/package-tarball-smoke.mjs",
    "test:coverage": "turbo run test:coverage",
    "db:generate": "pnpm --filter @prosewire/db generate",
    "db:migrate": "pnpm --filter @prosewire/db migrate",
    "db:push": "pnpm --filter @prosewire/db push",
    "db:studio": "pnpm --filter @prosewire/db studio",
    "prepare": "(lefthook install || true) && effect-language-service patch",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm test:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@effect/language-service": "^0.87.2",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "lefthook": "^2.1.6",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
