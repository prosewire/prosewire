{
  "name": "prosewire",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node --env-file=.env node_modules/turbo/bin/turbo run dev",
    "dev:web": "node --env-file=.env --run dev:web:workspace",
    "dev:web:workspace": "pnpm --filter @prosewire/web dev",
    "dev:site": "pnpm --filter @prosewire/site dev",
    "dev:services": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:packages",
    "test:pre-push": "pnpm typecheck && pnpm test",
    "test:database": "pnpm --filter @prosewire/db test:database && pnpm --filter @prosewire/web test:database && pnpm --filter @prosewire/worker test:database",
    "test:packages": "node scripts/package-tarball-smoke.mjs",
    "test:coverage": "turbo run test:coverage",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "test:acceptance": "pnpm --filter @prosewire/web test:acceptance",
    "test:docs": "SITE_URL=https://prosewire.test pnpm --filter @prosewire/site build",
    "test:image": "scripts/container-runtime-smoke.sh prosewire:release-readiness",
    "db:generate": "pnpm --filter @prosewire/db generate",
    "db:migrate": "pnpm --filter @prosewire/db migrate",
    "db:push": "pnpm --filter @prosewire/db push",
    "db:studio": "pnpm --filter @prosewire/db studio",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi && effect-tsgo patch",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-package-versions.mjs && biome format --write package.json packages/*/package.json",
    "release:preflight": "node scripts/release-preflight.mjs && pnpm test:packages",
    "lint:workflows": "scripts/workflow-lint.sh",
    "scan:secrets": "scripts/secret-scan.sh",
    "release": "pnpm release:preflight && changeset publish",
    "verify:registry": "node scripts/verify-published-packages.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@changesets/cli": "^3.0.1",
    "@effect/tsgo": "^0.36.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "lefthook": "^2.1.6",
    "npm": "11.6.2",
    "turbo": "^2.10.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  }
}
