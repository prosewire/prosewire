{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prosewire",
  "compatibility_date": "2026-08-19",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "prosewire.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
