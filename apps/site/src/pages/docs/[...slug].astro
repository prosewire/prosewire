---
import { render, type CollectionEntry } from "astro:content";
import type { TOCItemType } from "fumadocs-core/toc";
import defaultMdxComponents from "fumadocs-ui/mdx";
import { Docs } from "../../components/Docs";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { source } from "../../lib/source";

interface Props { page: CollectionEntry<"docs"> }

export async function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: { slug: page.slugs.length > 0 ? page.slugs.join("/") : undefined },
    props: { page: page.data._raw },
  }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const toc: TOCItemType[] = headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: `#${heading.slug}`,
}));
---

<BaseLayout title={`${page.data.title} · Prosewire Docs`} description={page.data.description} image={null} hideHeader>
  <Docs tree={source.getPageTree()} pathname={Astro.url.pathname} params={Astro.params} page={{ toc }} client:load>
    <h1 class="text-3xl font-semibold tracking-tight">{page.data.title}</h1>
    <p class="mb-8 text-lg text-fd-muted-foreground">{page.data.description}</p>
    <div class="prose flex-1"><Content components={{ ...defaultMdxComponents }} /></div>
  </Docs>
</BaseLayout>
