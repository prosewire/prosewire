{
  "name": "@prosewire/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node ../../scripts/check-site-origin.mjs && astro build && node ../../scripts/validate-docs.mjs",
    "build:production": "node ../../scripts/check-site-origin.mjs --production && astro build && node ../../scripts/validate-docs.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "lint": "astro sync && biome lint .",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "fumadocs-core": "^16.15.5",
    "fumadocs-ui": "^16.15.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@prosewire/config": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
