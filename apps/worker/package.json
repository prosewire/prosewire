{
  "name": "@prosewire/worker",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsdown --config tsdown.config.ts",
    "lint": "biome lint src tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:database": "vitest run src/email-outbox.test.ts src/publishing.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prosewire/db": "workspace:*",
    "@prosewire/jobs": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-rc.110",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.110",
    "@prosewire/config": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  }
}
