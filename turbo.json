{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["PUBLISHED_PACKAGES"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_DEPLOYMENT_ID",
        "PROSEWIRE_EXPOSE_TESTING_API",
        "SITE_URL",
        "WORKERS_CI"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL"],
      "outputs": ["coverage/**"]
    }
  }
}
