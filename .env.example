# Core services
DATABASE_URL=postgres://prosewire:prosewire@localhost:5432/prosewire
# Used by the bundled Docker Compose Postgres service
POSTGRES_PASSWORD=prosewire
# PROSEWIRE_MIGRATIONS_DIR=/absolute/path/to/packages/db/drizzle

# Dashboard authentication
BETTER_AUTH_SECRET=local-development-secret-change-before-production
PROSEWIRE_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_PROSEWIRE_PUBLIC_URL=http://localhost:3000
# Keep this value stable across web replicas and rolling releases
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Set the same release identifier on every replica of one deployment
NEXT_DEPLOYMENT_ID=local-development
# Open registration is useful only while bootstrapping the first workspace
PROSEWIRE_ALLOW_SIGN_UP=false

# Optional social sign-in for docker-compose.cloud.yml only
# PROSEWIRE_GOOGLE_CLIENT_ID=
# PROSEWIRE_GOOGLE_CLIENT_SECRET=
# PROSEWIRE_GITHUB_CLIENT_ID=
# PROSEWIRE_GITHUB_CLIENT_SECRET=

# Required in production for workspace invitations
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=Prosewire <no-reply@example.com>

# Development seed only; production startup does not read these values
ADMIN_EMAIL=admin@prosewire.local
ADMIN_PASSWORD=prosewire-local-dev
# Optional one-time API key provisioned on the first boot (24+ unique characters)
# PROSEWIRE_SEED_API_KEY=

# Public blog used by the dashboard preview and embed examples
PROSEWIRE_DEFAULT_BLOG=fieldnotes

# Raw first-party page-view events are deleted by the worker after this period
PROSEWIRE_ANALYTICS_RETENTION_DAYS=365
